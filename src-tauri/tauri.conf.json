{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Retirement Planner",
  "version": "1.0.0",
  "identifier": "com.eelozano.retirement",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "beforeBundleCommand": "sh scripts/warm-actool.sh",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Retirement Planner",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/RetirementPlanner.icon",
      "icons/icon.ico"
    ]
  }
}
